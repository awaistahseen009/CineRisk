# --- Google Cloud / Gemini Enterprise Agent Platform ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Use 'global' (aiplatform.googleapis.com) rather than a region:
# regional endpoints have a much tighter per-region Gemini quota and
# were the direct cause of 429 RESOURCE_EXHAUSTED specialist failures.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 thinking budget. 0 disables thinking for lower latency and
# fewer output tokens (which also eases the Vertex per-minute quota).
# Raise it only if grounding quality regresses.
GEMINI_THINKING_BUDGET=0

# --- Parallel research API (grounding) ---
PARALLEL_API_KEY=

# Optional deep-verification escalation via Parallel's Task API (Basis
# framework: per-field citations, reasoning, and calibrated confidence).
# ADDITIVE -- the Search API path above always runs first and is unaffected.
# When enabled, a high-severity flag the Search path could NOT ground is
# re-checked with the Task API before being reported as unconfirmed.
# Measured on this project: Search path ~2-4s and it grounded 0 of 5 results
# on the Scene 2 cultural-sensitivity concern; Task API 'core' took ~230s and
# grounded the same concern with 5 real cited incidents (NYT/LA Times). So:
# markedly better precedents, ~100x the latency. Off by default; turn it on
# for demo/report runs where grounding depth matters more than wall clock.
ENABLE_TASK_API_VERIFICATION=false
TASK_API_PROCESSOR=core
TASK_API_TIMEOUT_SECONDS=600

# Parallel "Deep Research" -- NOT a separate API. Same Task API call as
# above, pointed at the pro/ultra processor family instead of core (see
# docs.parallel.ai/task-api/task-deep-research). A second, deeper, slower
# escalation tier on top of deep verification: still additive, still opt-in
# per run, still scoped to high-severity flags the fast path could not
# ground. If both this and deep verification are requested for the same
# run, deep research wins. `pro` is the more conservative of the two tiers
# Parallel recommends; `ultra` is markedly slower again.
ENABLE_DEEP_RESEARCH=false
DEEP_RESEARCH_PROCESSOR=pro
DEEP_RESEARCH_TIMEOUT_SECONDS=1800

# --- Neon serverless Postgres ---
DATABASE_URL=postgresql+psycopg://user:password@ep-example.neon.tech/cinerisk?sslmode=require

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
